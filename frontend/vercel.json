{
  "rewrites": [
    { "source": "/developers", "destination": "/developers/index.html" },
    { "source": "/developers/", "destination": "/developers/index.html" },
    { "source": "/((?!api/|developers/).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
} 
